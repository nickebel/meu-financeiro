{
  "name": "meu-financeiro",
  "version": "1.0.0",
  "description": "Aplicativo pessoal de finanças com modo offline e sincronização Supabase.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "build:win-icon": "node scripts/build-win-icon.cjs",
    "start:desktop": "npm run build:web && electron .",
    "dist:windows": "npm run build:web && npm run build:win-icon && electron-builder --win --x64 --publish never",
    "build:android": "npm run build:web && cap add android && node scripts/apply-android-branding.cjs && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.80.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.17.0",
    "png-to-ico": "^2.1.0",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.nickebel.meufinanceiro",
    "productName": "Meu Financeiro",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json",
      "app-icon.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meu Financeiro"
    },
    "portable": {
      "artifactName": "Meu-Financeiro-${version}-portable.exe"
    },
    "artifactName": "Meu-Financeiro-${version}-${arch}.${ext}"
  }
}
